# --- Database (Supabase Postgres, Mumbai region) ---
# Use the transaction pooler URL (port 6543) on Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edapt
# Connections per server process (default 5)
DATABASE_POOL_MAX=5

# Public URL of the app, used in emails and links
APP_URL=http://localhost:3000

# --- First admin, created by `npm run db:seed` (the /setup page asks for its own details instead) ---
ADMIN_EMAIL=umer@edapt.in
ADMIN_NAME=Umer Abdussalam
ADMIN_PASSWORD=change-me-now

# --- Cron (Vercel sends `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=dev-cron-secret

# --- Webhooks: each integration calls /api/webhooks/<source>?token=<secret> ---
TAGMANGO_WEBHOOK_SECRET=dev-tagmango-secret
LIBROMI_WEBHOOK_SECRET=dev-libromi-secret
PABBLY_WEBHOOK_SECRET=dev-pabbly-secret

# --- File uploads (payment proofs, import files) ---
# When set, files go to Supabase Storage; otherwise to ./uploads (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-files

# --- AI column mapping for imports (Claude API) ---
ANTHROPIC_API_KEY=

# --- Email digests (Resend). Without a key, emails are printed to the server log. ---
RESEND_API_KEY=
EMAIL_FROM=Edapt CRM <crm@edapt.in>

# --- Development and test only: set these on the command line, not here ---
# NEXT_DIST_DIR=.next-3201          build dir, so several dev servers can run side by side (next.config.ts)
# TEST_DATABASE_URL=postgres://...  database for `npm test` instead of the one in .env.test
# E2E_DATABASE_URL, E2E_PORT, E2E_DEMO=0, E2E_SKIP_BUILD=1   `npm run test:e2e` (tests/e2e/support/env.ts)
# BENCH_PROFILE=1, BENCH_CHUNK=500  scripts/bench-import.ts
