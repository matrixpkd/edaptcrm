{
  "name": "edaptcrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "tsx scripts/db-custom.ts && drizzle-kit push --force && tsx scripts/db-custom.ts --after",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:seed:scale": "tsx --conditions=react-server scripts/seed-scale.ts --contacts 50000",
    "db:reset": "tsx --conditions=react-server scripts/reset.ts",
    "cron:schedule": "tsx scripts/schedule-cron.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@date-fns/tz": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "next": "15.5.27",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
